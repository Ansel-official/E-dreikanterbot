# ============================================================
#  E-dreikanterbot 配置示例
#  复制为 .env 后填写。最少只需要一个上游 Key（DeepSeek 或 Kimi）。
# ============================================================

# ---------- DeepSeek（官方文档：https://api-docs.deepseek.com） ----------
# 在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- Kimi / Moonshot（官方文档：https://platform.kimi.com/docs） ----------
# 在 https://platform.moonshot.cn/console/api-keys 创建；留空则只启用 DeepSeek
KIMI_API_KEY=
# 国内：https://api.moonshot.cn/v1；海外：https://api.moonshot.ai/v1
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---------- 服务 ----------
# 监听地址与端口；0.0.0.0 表示允许局域网/公网访问
HOST=0.0.0.0
PORT=8788

# 站点时区与日期提示
TIMEZONE=Asia/Shanghai

# 默认模型；必须是 /api/models 中的 ID。
# DeepSeek: deepseek-flash | deepseek-v4-pro
# Kimi:     kimi-k3.1-pro | kimi-k3.1-pro-highspeed | kimi-k3 | kimi-k2.7-code | kimi-k2.6
DEFAULT_MODEL=deepseek-flash

# 对外访问密码。留空 = 本机/内网直接可用；一旦公网部署，务必设置！
# 设置后：网页端需登录；/v1/* 接口需 Authorization: Bearer <ACCESS_TOKEN>
ACCESS_TOKEN=

# 数据目录（会话、记忆库、附件），相对项目根目录
DATA_DIR=./data

# 反向代理层数（nginx 时设为 1，用于取真实 IP 做限流）
TRUST_PROXY=0

# ---------- 记忆库 ----------
MEMORY_ENABLED=true
# 每轮注入的长期记忆条数上限
MEMORY_TOP_K=8
# 注入记忆块的字符上限（防止吃满上下文）
MEMORY_MAX_CHARS=4000
# 对话历史保留的 token 预算（按模型上下文再收窄）
MAX_CONTEXT_TOKENS=900000
# 历史消息条数硬上限（0 = 不限制）
MAX_HISTORY_MESSAGES=400

# ---------- 生成默认参数 ----------
# 默认开启思考模式；effort 可选 none | low | high | max
DEFAULT_THINKING=true
DEFAULT_REASONING_EFFORT=high
# 默认最大输出 token。DeepSeek 上限 393216；Kimi K3 上限 1048576（max_completion_tokens）
DEFAULT_MAX_TOKENS=65536
DEFAULT_TEMPERATURE=1
DEFAULT_TOP_P=0.95

# 内容安全。仅 DeepSeek 支持；公共服务请保持 high。
# 注意：high 模式下 temperature/top_p/stop 等参数会被官方忽略（见 docs/API.md）。
SAFETY_LEVEL=high

# 让 DeepSeek 官方接口生成会话标题（Kimi 不支持，自动跳过）
TITLE_ENABLED=true

# 默认启用联网搜索 / 读链接（仅 DeepSeek 官方 web tools）
WEB_TOOLS_ENABLED=false

# 系统人设。留空使用内置默认人设。
# 注意：Kimi 会在 system 里自动追加“由 Kimi API 提供”的身份提示。
SYSTEM_PROMPT=

# ---------- 对外接口 ----------
# /v1 接口的 CORS 来源，* 表示允许任意来源（配合 Bearer Token 使用）
CORS_ORIGIN=*
# 单 IP 聊天限流（次/分钟）与普通接口限流
RATE_LIMIT_CHAT=30
RATE_LIMIT_API=300
# 请求体上限（字节），含 base64 图片；默认 48MB（与官方一致）
MAX_BODY_BYTES=50331648

# ---------- 站点与备案信息 ----------
SITE_NAME=E-dreikanterbot
SITE_URL=
CONTACT_EMAIL=
# 例如：京ICP备2026000000号-1（未配置时页脚会显示提醒）
ICP_NUMBER=
ICP_LINK=https://beian.miit.gov.cn/
# 公安联网备案号，例如：京公网安备 11010502000000号
POLICE_NUMBER=
POLICE_LINK=https://beian.mps.gov.cn/

# ---------- 高级 ----------
# 会话 cookie 签名密钥；留空自动生成并保存在 data/secret.txt
SESSION_SECRET=
# 单次上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=600000
